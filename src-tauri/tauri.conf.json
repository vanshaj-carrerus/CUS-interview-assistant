{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CUS Interview Assistant",
  "mainBinaryName": "CUS Interview Assistant",
  "version": "0.0.3",
  "identifier": "com.cus.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CUS Interview Assistant",
        "width": 600,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "skipTaskbar": false,
        "transparent": true,
        "alwaysOnTop": false,
        "decorations": true,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vosk/libvosk.dll": "libvosk.dll",
      "vosk/libgcc_s_seh-1.dll": "libgcc_s_seh-1.dll",
      "vosk/libstdc++-6.dll": "libstdc++-6.dll",
      "vosk/libwinpthread-1.dll": "libwinpthread-1.dll"
    }
  }
}
