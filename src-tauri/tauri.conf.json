{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CUS Interview Assistant",
  "mainBinaryName": "CUS Interview Assistant",
  "version": "1.0.0",
  "identifier": "com.cus.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CUS Interview Assistant",
        "width": 600,
        "height": 600,
        "minWidth": 340,
        "minHeight": 260,
        "resizable": true,
        "fullscreen": false,
        "skipTaskbar": true,
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": true,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGN0E4NUJBQURGQ0Y3MkEKUldRcTkveXR1b1Y2ZjlBczNtSDVtZkNmWGZkdzZtREdjMGxjellvNlFCaFY5Z0ptUUVoVEwzdEMK",
      "endpoints": [
        "https://github.com/vanshaj-carrerus/CUS-interview-assistant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "models/whisper/": "models/whisper/"
    }
  }
}
